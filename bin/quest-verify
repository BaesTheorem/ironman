#!/usr/bin/env python3
"""Verify quest attempts against Fitbit and write the result into the log.

The phone records each attempt in ``quest.sessions``; Fitbit records the run
the watch saw. This matches the two by time, stamps a ``verification`` on
the attempt, appends free runs the watch saw with no attempt, and rewrites
``exercise-log.json`` with a fresh ``updatedAt`` so the app adopts it on its
next foreground. Idempotent: run it as often as you like.

    quest-verify                 # verify the last 14 days, print what changed
    quest-verify --days 30
    quest-verify --json          # events as JSON (for a watcher)
    quest-verify --dry-run       # match, print, write nothing

Fitbit exercises come from the Google Health API v4 (the Fitbit Web API shut
down on 2026-10-30), converted to the Fitbit activity shape quest.py matches
on. The access token comes from the harness fitbit-mcp/bin/google-health-token.
A token or API failure is exit 2.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
sys.path.insert(0, str(HERE))
import quest as q  # noqa: E402
import google_health as gh  # noqa: E402

def _activity_name(ex: dict) -> str:
    """displayName plus the type in words quest.py's EXCLUDED / RUNNING_WORDS
    match on ('BIKING' must read as 'bike', 'RUNNING' as 'run')."""
    words = ex.get("exerciseType", "").lower().replace("_", " ").replace("biking", "bike").replace("cycling", "cycle")
    words = words.replace("running", "run").replace("jogging", "jog")
    name = ex.get("displayName") or ""
    return f"{name} ({words})" if name else words


def to_fitbit_activity(p: dict) -> dict:
    """A Google exercise data point in the Fitbit activity shape quest.py reads.
    activityLevel comes from heart-rate zone time (Fitbit used METs):
    'very' = vigorous + peak minutes, 'fairly' = moderate minutes."""
    ex = p["exercise"]
    start = datetime.fromisoformat(ex["interval"]["startTime"].replace("Z", "+00:00"))
    end = datetime.fromisoformat(ex["interval"]["endTime"].replace("Z", "+00:00"))
    m = ex.get("metricsSummary", {})
    z = m.get("heartRateZoneDurations", {})
    act = {
        "logId": int(p["name"].rsplit("/", 1)[-1]),
        "activityName": _activity_name(ex),
        "startTime": ex["interval"]["startTime"],
        "duration": int((end - start).total_seconds() * 1000),
        "distance": float(m.get("distanceMillimeters", 0) or 0) / 1e6,
        "activityLevel": [
            {"name": "very", "minutes": int((gh.seconds(z.get("vigorousTime")) + gh.seconds(z.get("peakTime"))) // 60)},
            {"name": "fairly", "minutes": int(gh.seconds(z.get("moderateTime")) // 60)},
        ],
    }
    if m.get("averageHeartRateBeatsPerMinute") is not None:
        act["averageHeartRate"] = int(m["averageHeartRateBeatsPerMinute"])
    return act


def fetch_activities(after: datetime) -> list[dict]:
    tok = gh.token()
    local = after.astimezone().strftime("%Y-%m-%dT%H:%M:%S")
    points = gh.list_points(tok, "exercise", f'exercise.interval.civil_start_time >= "{local}"', page_size=25)
    return sorted((to_fitbit_activity(p) for p in points), key=lambda a: a["startTime"])


def describe(ev: dict) -> str:
    a = ev.get("activity", {})
    km = f"{a.get('distanceKm', 0):.2f} km" if a else ""
    if ev["type"] == "verified":
        return f"verified week {ev['week']} day {ev['day']}: {a['activityName']}, {a['durationSeconds'] // 60} min, {km}, {ev['xp']} xp"
    if ev["type"] == "free_run":
        return f"free run: {a['activityName']} {a['startTime'][:10]}, {a['durationSeconds'] // 60} min, {km}, {ev['xp']} xp"
    if ev["type"] == "level_up":
        return f"level up: {ev['from']} -> {ev['to']} ({ev['xp']} xp)"
    if ev["type"] == "chapter_done":
        return f"chapter {ev['week']} done: {ev['title']}"
    return json.dumps(ev)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--file", help="exercise-log.json (default: the app's sync folder)")
    ap.add_argument("--days", type=int, default=14, help="how far back to pull Fitbit activities")
    ap.add_argument("--json", action="store_true", help="print the events as JSON")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    # The reader owns file discovery; borrow it rather than duplicate the paths.
    import importlib.machinery
    import importlib.util
    spec = importlib.util.spec_from_loader("exercise_log", importlib.machinery.SourceFileLoader("exercise_log", str(HERE / "exercise-log")))
    reader = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(reader)
    path = reader.locate(args.file)
    data = reader.load(path)

    after = datetime.now(timezone.utc) - timedelta(days=args.days)
    activities = fetch_activities(after)

    before = json.dumps(data, sort_keys=True)
    data, events = q.apply(data, activities)
    changed = json.dumps(data, sort_keys=True) != before

    if changed and not args.dry_run:
        data["updatedAt"] = q.iso(datetime.now(timezone.utc))
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
        os.replace(tmp, path)

    if args.json:
        print(json.dumps({"events": events, "changed": changed, "dryRun": args.dry_run,
                          "summary": q.summary(data["quest"]), "file": str(path)}, indent=1))
        return
    s = q.summary(data["quest"])
    print(f"{len(activities)} Fitbit activities since {after:%Y-%m-%d}; level {s['level']}, {s['xp']} xp")
    for ev in events:
        print("  " + describe(ev))
    if not events:
        print("  nothing new")
    if changed and args.dry_run:
        print("  (dry run: not written)")


if __name__ == "__main__":
    main()
